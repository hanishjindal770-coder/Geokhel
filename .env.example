# Upstash Redis (leaderboards, players, groups). Adding Upstash from the Vercel Marketplace
# sets KV_REST_API_URL / KV_REST_API_TOKEN automatically; those work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Google Sheet with the questions, published as CSV (File > Share > Publish to web > CSV).
# Leave empty to use the built-in questions.
QUESTIONS_CSV_URL=
# Any long random string. Signs rounds and challenge links so scores can't be forged.
ROUND_SECRET=
# Public URL used in share links, e.g. https://geokhel.vercel.app
NEXT_PUBLIC_SITE_URL=
