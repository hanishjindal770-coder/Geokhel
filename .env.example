# Supabase project (Settings > API). The service role key stays on the server; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Signs round tokens so scores can't be forged.
ROUND_SECRET=
# Public URL used in share links, e.g. https://geokhel.vercel.app
NEXT_PUBLIC_SITE_URL=
